{
  "name": "@vplayer/core",
  "version": "0.4.5",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divyam234/vplayer.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mediabunny/ac3": "1.61.4",
    "@tanstack/store": "^0.11.1",
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.1",
    "mediabunny": "1.61.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
